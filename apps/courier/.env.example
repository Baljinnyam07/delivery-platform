# Public values only — never put a secret key in the app.
# Local: values from `pnpm supabase status -o env` (API_URL, PUBLISHABLE_KEY).
# On a physical phone, replace 127.0.0.1 with your computer's LAN IP (e.g. http://192.168.1.20:55321).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
